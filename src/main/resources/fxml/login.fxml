<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.pdv.controlador.LoginController"
            prefWidth="900"
            prefHeight="600"
            styleClass="tela-login"
            stylesheets="@../css/login.css">

    <center>

        <VBox alignment="CENTER"
              spacing="14"
              maxWidth="380"
              styleClass="cartao-login">

            <padding>
                <Insets top="30"
                        right="40"
                        bottom="30"
                        left="40"/>
            </padding>

            <Region prefHeight="15"/>

            <!-- USUÁRIO -->

            <Label text="Usuário"
                   maxWidth="Infinity"
                   styleClass="rotulo-campo"/>

            <TextField fx:id="campoUsuario"
                       promptText="Digite seu usuário"
                       prefHeight="42"
                       styleClass="campo-login"/>

            <!-- SENHA -->

            <StackPane>

                <PasswordField fx:id="campoSenha"
                               promptText="Digite sua senha"
                               prefHeight="42"
                               styleClass="campo-login, campo-senha"
                               onAction="#aoEntrar"/>

                <TextField fx:id="campoSenhaVisivel"
                           promptText="Digite sua senha"
                           prefHeight="42"
                           styleClass="campo-login, campo-senha"
                           visible="false"
                           managed="false"
                           onAction="#aoEntrar"/>

                <ToggleButton fx:id="botaoMostrarSenha"
                              onAction="#aoAlternarVisibilidadeSenha"
                              focusTraversable="false"
                              styleClass="botao-olho"
                              StackPane.alignment="CENTER_RIGHT">

                    <graphic>
                        <SVGPath styleClass="icone-olho"
                                 content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5C21.27 7.61 17 4.5 12 4.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                    </graphic>

                </ToggleButton>

            </StackPane>

            <Button text="ENTRAR"
                    prefHeight="44"
                    maxWidth="Infinity"
                    styleClass="botao-entrar"
                    onAction="#aoEntrar"
                    defaultButton="true"/>


            <Region prefHeight="20"/>

            <Label text="PDV • Versão 1.0"
                   styleClass="versao-sistema"/>

            <HBox alignment="CENTER"
                  spacing="8">

                <Label text="Desenvolvido por"
                       styleClass="fabricante"/>

                <Label text="Igor Marques"
                       styleClass="credito-desenvolvedor"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>