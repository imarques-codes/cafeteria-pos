<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.pdv.controlador.PagamentoController"
            prefWidth="720"
            prefHeight="620"
            stylesheets="@../css/pagamento.css"
            styleClass="tela-pagamento">

    <center>

        <VBox alignment="CENTER"
              spacing="18"
              maxWidth="520">

            <padding>
                <Insets top="25"
                        right="35"
                        bottom="25"
                        left="35"/>
            </padding>

            <ImageView fitWidth="120"
                       fitHeight="85"
                       preserveRatio="true"
                       smooth="true">
                <image>
                    <Image url="@../imagens/logo-le-cafe.png"/>
                </image>
            </ImageView>

            <Label text="FINALIZAR VENDA"
                   styleClass="titulo-pagamento"/>

            <VBox maxWidth="440"
                  spacing="5"
                  styleClass="painel-total">

                <Label text="TOTAL DA VENDA"
                       styleClass="titulo-total"/>

                <Label fx:id="rotuloTotalVenda"
                       text="R$ 0,00"
                       styleClass="valor-total"/>

            </VBox>

            <Label text="Forma de pagamento"
                   styleClass="titulo-secao"/>

            <GridPane hgap="12"
                      vgap="12"
                      maxWidth="440">

                <Button fx:id="botaoDinheiro"
                        text="DINHEIRO"
                        onAction="#aoSelecionarDinheiro"
                        prefWidth="210"
                        prefHeight="55"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="0"
                        styleClass="botao-pagamento"/>

                <Button fx:id="botaoPix"
                        text="PIX"
                        onAction="#aoSelecionarPix"
                        prefWidth="210"
                        prefHeight="55"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="0"
                        styleClass="botao-pagamento"/>

                <Button fx:id="botaoCredito"
                        text="CRÉDITO"
                        onAction="#aoSelecionarCredito"
                        prefWidth="210"
                        prefHeight="55"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="1"
                        styleClass="botao-pagamento"/>

                <Button fx:id="botaoDebito"
                        text="DÉBITO"
                        onAction="#aoSelecionarDebito"
                        prefWidth="210"
                        prefHeight="55"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="1"
                        styleClass="botao-pagamento"/>

            </GridPane>

            <VBox spacing="6"
                  maxWidth="440">

                <Label text="Valor recebido"
                       styleClass="rotulo-campo"/>

                <TextField fx:id="campoValorRecebido"
                           promptText="R$ 0,00"
                           prefHeight="46"
                           styleClass="campo-valor"/>

            </VBox>

            <VBox spacing="6"
                  maxWidth="440">

                <Label text="Troco"
                       styleClass="rotulo-campo"/>

                <Label fx:id="rotuloTroco"
                       text="R$ 0,00"
                       styleClass="valor-troco"/>

            </VBox>

            <HBox maxWidth="440"
                  spacing="12">

                <Button fx:id="botaoCancelar"
                        text="CANCELAR"
                        onAction="#aoCancelar"
                        prefHeight="48"
                        prefWidth="150"
                        styleClass="botao-cancelar"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="botaoConfirmar"
                        text="CONFIRMAR PAGAMENTO"
                        onAction="#aoConfirmarPagamento"
                        prefHeight="48"
                        prefWidth="260"
                        styleClass="botao-confirmar"/>

            </HBox>

            <Label text="Le Café | Cafeteria Premium"
                   styleClass="rodape"/>

        </VBox>

    </center>

</BorderPane>